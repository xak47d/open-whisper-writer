# Maintainer: xak47d <https://github.com/xak47d>

pkgname=whisper-writer
pkgver=1.1.0
pkgrel=1
pkgdesc="Speech-to-text voice typing powered by OpenAI Whisper"
arch=('x86_64')
url="https://github.com/xak47d/open-whisper-writer"
license=('GPL-3.0-or-later')
depends=(
    'portaudio'
    'libsndfile'
    'python'
    'python-pyqt5'
    'libxkbcommon'
)
makedepends=(
    'python-pip'
    'python-setuptools'
    'python-wheel'
    'python-pyinstaller'
)
optdepends=(
    'cuda: NVIDIA GPU acceleration'
    'cudnn: NVIDIA GPU acceleration'
    'ydotool: Alternative input simulation backend'
    'dotool: Alternative input simulation backend'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "open-${pkgname}-${pkgver}"

    # Create a virtual environment for building
    python -m venv --system-site-packages buildenv
    source buildenv/bin/activate

    # Install dependencies
    pip install --no-cache-dir ".[dev]"

    # Build with PyInstaller
    pyinstaller --noconfirm --clean whisper-writer.spec

    deactivate
}

package() {
    cd "open-${pkgname}-${pkgver}"

    # Install the PyInstaller output
    install -dm755 "${pkgdir}/opt/${pkgname}"
    cp -r dist/whisper-writer/* "${pkgdir}/opt/${pkgname}/"

    # Create launcher symlink
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/${pkgname}" << 'EOF'
#!/bin/sh
exec /opt/whisper-writer/whisper-writer "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/${pkgname}"

    # Install desktop file
    install -Dm644 whisper-writer.desktop \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop"
    sed -i \
        -e "s|^Exec=.*|Exec=/opt/${pkgname}/${pkgname}|" \
        -e "s|^Icon=.*|Icon=${pkgname}|" \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop"

    # Install icon
    install -Dm644 assets/ww-logo.png \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"

    # Install AppStream metadata
    install -Dm644 io.github.xak47d.whisper-writer.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/io.github.xak47d.whisper-writer.metainfo.xml"

    # Install license
    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
